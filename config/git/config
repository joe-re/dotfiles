[core]
  editor = vim
  quotepath = false
  precomposeunicode = true

[hub]
  protocol = https

[user]
  name = joe-re
  email = joe.tialtngo@gmail.com

[color]
  ui = auto

[alias]
  co = checkout
  st = status -sb
  stat = status
  ci = commit
  br = branch
  pick = cherry-pick
  # ログを見やすく http://hail2u.net/blog/software/easy-to-read-git-log.html
  l = log --graph --pretty='format:%C(yellow)%h%Cblue%d%Creset %s %C(green bold)%an, %ar%Creset'
  ll = log
  # 行単位ではなく単語単位でdiffを表示
  d = diff --word-diff
  # HEADから3日間のログをdiff付きで表示する
  difflog = log -p HEAD@{3.days.ago}
  edit-unmerged = "!f() { git ls-files --unmerged | cut -f2 | sort -u ; }; vim `f`"
  add-unmerged = "!f() { git ls-files --unmerged | cut -f2 | sort -u ; }; git add `f`"
  # rmコマンドを使わずに削除してしまったファイルをgit rmする
  rmd = "!f() { git ls-files --deleted ; }; git rm `f`"
  # merge済みのブランチを消す
	clean-branches = !git branch --merged | grep -v \\* | xargs -I {} git branch -d {}
  remote-add = "!f() { git config --get remote.origin.url | sed -e s/`git config user.name`/$1/ | xargs git remote add upstream; }; f"
  pr = "!f() { git fetch $1 pull/$2/head:pr$2; git checkout pr$2; }; f"

[push]
  default = simple

[ghq]
  root = ~/.ghq
  root = ~/.go/src
